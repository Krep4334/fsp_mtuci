# Database
DATABASE_URL="postgresql://username:password@localhost:5432/tournament_db"

# JWT
JWT_SECRET="your-super-secret-jwt-key-here"
JWT_EXPIRES_IN="7d"

# Server
PORT=3001
NODE_ENV="development"

# CORS
CLIENT_URL="http://localhost:5173"

# Upload (локальные файлы, если используешь)
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE=5242880

# Объектное хранилище S3-совместимое (MinIO, AWS S3 и т.д.)
# В NODE_ENV !== production эти значения подставляются по умолчанию (localhost:9000, minioadmin),
# если переменные не заданы — достаточно поднять MinIO.
# Явно задать (и для production):
S3_ENDPOINT="http://localhost:9000"
S3_PUBLIC_URL="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET="tournament-objects"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"
# Макс. размер одного файла в байтах (по умолчанию 20 МБ)
MAX_S3_FILE_SIZE=20971520
# Полностью выключить загрузки в S3 (ответ 503 на /api/storage/*)
# DISABLE_OBJECT_STORAGE=true
